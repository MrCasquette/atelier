{
  "name": "@prisme/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun --env-file=../../.env --env-file=../../.env.prisme test src",
    "type-check": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env --env-file=../../.env.prisme drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env --env-file=../../.env.prisme drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env --env-file=../../.env.prisme drizzle-kit push",
    "db:studio": "bun --env-file=../../.env --env-file=../../.env.prisme drizzle-kit studio"
  },
  "dependencies": {
    "@repo/assets": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/identity": "workspace:*",
    "@repo/menus": "workspace:*",
    "@repo/pages": "workspace:*",
    "@repo/references": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "6.0.3"
  }
}
