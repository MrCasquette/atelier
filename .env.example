# ===========================================
# Échoppe - Environment Configuration
# ===========================================
# Copy this file to .env and configure
# Or run: ./scripts/docker-init.sh

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://echoppe:echoppe@localhost:5432/echoppe
POSTGRES_USER=echoppe
POSTGRES_PASSWORD=echoppe
POSTGRES_DB=echoppe

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Ports
# ===========================================
# Aucun port ne se configure ici (ADR-0054) : chaque pile porte son rang en dur, dans le fichier
# qui la définit. Le rang 0 appartient au produit, et le développement du framework prend le 1 —
# de sorte qu'une boutique et ce dépôt tournent ensemble sans arbitrage.
#
#   :8100  l'API du produit — port interne du conteneur, et boutique du consommateur
#   :8101  l'API de `bun run dev` (apps/echoppe-api/package.json)
#   :8102  l'image publiée, via `docker compose --profile release` (compose.yaml)
#   :3100  la vitrine du dépôt (apps/echoppe-store/astro.config.mjs)
#   :3110  le serveur Vite du dashboard (apps/echoppe-admin/vite.config.ts)
#
# `API_PORT` reste la variable de l'exploitant : renseignez-la pour déplacer le mapping publié.
# Cf. docs-internal/reference/ports.md

# ===========================================
# API
# ===========================================
# Où joindre le dashboard — liens d'invitation et liste blanche de redirection. Il est servi PAR
# l'API sous /-/admin (ADR-0052), donc cette URL suit celle de l'API.
ADMIN_URL=http://localhost:8101/-/admin

# ===========================================
# Store (Astro)
# ===========================================
# URL publique de la vitrine, transmise à l'API (CORS).
STORE_URL=http://localhost:3100

# ===========================================
# Security (REQUIRED for production)
# ===========================================
# 32-byte hex key for encrypting sensitive data
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ===========================================
# Docker Distribution (optional)
# ===========================================
# Registry for pulling images
DOCKER_REGISTRY=echoppe
# Image version tag
VERSION=latest

# ===========================================
# Payment Providers (optional)
# ===========================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ===========================================
# Email Provider (optional)
# ===========================================
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Resend (alternative)
RESEND_API_KEY=

# Brevo (alternative)
BREVO_API_KEY=

# ===========================================
# DEV CREDENTIALS (created by db:seed)
# ===========================================
# Admin login: admin@echoppe.dev / admin123
# DB access:   echoppe / echoppe
