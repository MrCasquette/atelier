{
  "name": "atelier",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "scripts": {
    "dev": "bun run dev:api & bun run dev:admin & bun run dev:store",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "dev:api": "bun run --cwd apps/echoppe-api dev",
    "dev:admin": "bun run --cwd apps/echoppe-admin dev",
    "dev:store": "bun run --cwd apps/echoppe-store dev",
    "build": "bun run --filter '*' build",
    "type-check": "bun run --filter '*' type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write",
    "db:generate": "bun run --cwd packages/echoppe-core db:generate",
    "db:migrate": "bun run --cwd packages/echoppe-core db:migrate",
    "db:push": "bun run --cwd packages/echoppe-core db:push",
    "db:studio": "bun run --cwd packages/echoppe-core db:studio",
    "db:seed": "bun run --cwd packages/echoppe-core db:seed",
    "drift-guard": "bun run scripts/drift-guard.ts",
    "product-isolation": "bun run scripts/product-isolation.ts",
    "reserved-space": "bun run scripts/reserved-space.ts",
    "image-manifests": "bun run scripts/image-manifests.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "sh scripts/release.sh",
    "test": "bun run --filter '*' test",
    "test:api": "bun run --cwd apps/echoppe-api test:api",
    "test:image": "bun run --cwd apps/echoppe-api test:image",
    "contracts": "bun run scripts/contracts.ts",
    "contracts:check": "bun run scripts/contracts.ts --check",
    "ship": "bun run scripts/ship.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.11.0",
    "typescript": "6.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1"
  }
}
