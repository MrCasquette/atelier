{
  "name": "@echoppe/api",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "API_PORT=8101 bun --env-file=../../.env run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=../../.env run dist/index.js",
    "admin:create": "bun --env-file=../../.env run src/scripts/create-admin.ts",
    "api-key:create": "bun --env-file=../../.env run src/scripts/create-api-key.ts",
    "type-check": "tsc --noEmit",
    "test": "bun --env-file=../../.env test src",
    "test:api": "bun run scripts/test-api.ts",
    "test:image": "bun run scripts/test-image.ts"
  },
  "dependencies": {
    "@echoppe/core": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@repo/assets": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/communication": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/fields": "workspace:*",
    "@repo/identity": "workspace:*",
    "@repo/menus": "workspace:*",
    "@repo/pages": "workspace:*",
    "@repo/pages-registry": "workspace:*",
    "@repo/references": "workspace:*",
    "@repo/shared": "workspace:*",
    "elysia": "^1.4.29",
    "elysia-rate-limit": "^4.6.2",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "6.0.3"
  }
}
